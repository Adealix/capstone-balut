  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "Owner",
              "Operator"
            ],
            "title": "Role",
            "default": "Operator"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "name"
        ],
        "title": "Account"
      },
      "AlertAction": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "acknowledge",
              "snooze",
              "resolve"
            ],
            "title": "Action"
          },
          "until": {
            "type": "string",
            "title": "Until",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "AlertAction"
      },
      "BatchEdit": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "title": "Source",
            "default": ""
          },
          "notes": {
            "type": "string",
